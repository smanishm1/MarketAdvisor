# Copy this file to ".env" (setup.bat does it for you) and adjust if you like.
# These defaults are the safe choices for someone else's PC: paper only,
# no API keys, no recurring cost.

# Paper mode only. Live execution is NOT importable until BOTH flags flip.
HERMES_TRADING_MODE=paper
HERMES_TRADING_I_ACCEPT_RISK=false

# Starting paper capital (USD)
HERMES_TRADING_START_EQUITY=10000

# Auto-reflection: worker proposes ONE strategy change every `reflection_every`
# closed trades (still requires a human click). "fallback" = deterministic rule,
# FREE, no API key, no extra install. Use "hermes" (Claude) only if you have the
# Hermes CLI installed AND a Claude API key configured on THIS PC (costs money).
HERMES_AUTO_REFLECT=true
HERMES_REFLECT_MODE=fallback

# Crypto exchange id — unused by the ETF rotation strategy, left for completeness.
HERMES_TRADING_EXCHANGE=kraken
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Discord approvals bot (optional). Posts pending trade/strategy approvals to a
# channel with Approve/Reject buttons. Requires:  pip install -e ".[discord]"
# 1) Create an app + bot at https://discord.com/developers/applications, paste the
#    bot token below. 2) Invite it to your server (scope: bot, perm: Send Messages).
# 3) Enable Developer Mode, right-click the channel -> Copy Channel ID.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
HERMES_DASHBOARD_URL=http://localhost:8000
